<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Warehouse">
<meta name="theme-color" content="#FAF6EE">
<link rel="apple-touch-icon" href="icon.png">
<link rel="manifest" href="manifest.json">
<title>Crown Elite Warehouse</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== Paste your Apps Script web app URL in the script section below (API = ...) ===== */
:root{
  --paper:#FAF6EE; --card:#FFFDF8; --ink:#2B211B; --soft:#6E5D50; --line:#E6D9C6;
  --copper:#A8612F; --copper-deep:#7E4521; --patina:#3E7C6F; --patina-soft:#E3EFEA;
  --warn:#B23A2A; --warn-soft:#F8E4DF; --tag:#F2E6D3;
  --r:10px;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--paper);color:var(--ink);font:16px/1.45 Barlow,"Helvetica Neue",Arial,sans-serif;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--copper);outline-offset:2px}

header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--paper);border-bottom:1px solid var(--line);
  display:flex;align-items:center;gap:12px;padding:12px 20px}
.brand{font-family:"Barlow Condensed",Arial Narrow,sans-serif;font-weight:700;font-size:26px;letter-spacing:.3px;line-height:1}
.brand small{display:block;font-family:Barlow,Arial,sans-serif;font-weight:500;font-size:12px;color:var(--soft);letter-spacing:0;margin-top:3px}
.who{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:14px;color:var(--soft)}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 12px;font-size:14px}
.chip.owner{background:var(--copper);border-color:var(--copper);color:#fff}

main{max-width:980px;margin:0 auto;padding:18px 20px calc(110px + env(safe-area-inset-bottom,0px))}
h1{font-family:"Barlow Condensed",Arial Narrow,sans-serif;font-weight:700;font-size:34px;line-height:1.05;margin:4px 0 14px}
h2{font-family:"Barlow Condensed",Arial Narrow,sans-serif;font-weight:600;font-size:22px;margin:22px 0 10px}
p.lead{color:var(--soft);margin:-6px 0 18px;max-width:60ch}

nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:6;background:var(--card);border-top:1px solid var(--line);
  display:grid;grid-template-columns:repeat(4,1fr);padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px))}
nav.tabs button{border:0;background:none;padding:8px 4px;border-radius:8px;font-family:"Barlow Condensed",sans-serif;font-weight:600;font-size:18px;color:var(--soft)}
nav.tabs button[aria-current="page"]{color:var(--copper-deep);background:var(--tag)}

/* Stock list: bin tags */
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.search{flex:1 1 260px;border:1px solid var(--line);background:var(--card);border-radius:var(--r);padding:12px 14px;font-size:17px}
.cats{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:10px;-webkit-overflow-scrolling:touch}
.cats button{flex:none;border:1px solid var(--line);background:var(--card);border-radius:999px;padding:6px 12px;font-size:14px;color:var(--soft)}
.cats button.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.list{border-top:1px solid var(--line)}
.row{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:12px 2px;border-bottom:1px solid var(--line);background:none;border-left:0;border-right:0;border-top:0;width:100%;text-align:left}
.row .name{font-weight:600;font-size:16px;line-height:1.25}
.row .meta{font-size:13px;color:var(--soft);margin-top:2px}
.tag{min-width:92px;text-align:right;background:var(--tag);border-radius:6px;padding:4px 10px 3px;position:relative}
.tag::before{content:"";position:absolute;left:8px;top:50%;width:7px;height:7px;margin-top:-3.5px;border-radius:50%;background:var(--paper);box-shadow:inset 0 0 0 1px var(--line)}
.tag b{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:28px;line-height:1;display:block}
.tag span{font-size:11px;color:var(--soft);letter-spacing:.2px}
.tag.zero{background:#EFEAE2;color:var(--soft)}
.tag.neg{background:var(--warn-soft);color:var(--warn)}
.count-line{font-size:14px;color:var(--soft);margin:0 0 8px}

/* Forms */
form.card,.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.field{margin-bottom:16px;position:relative}
.field label{display:block;font-weight:600;font-size:15px;margin-bottom:6px}
.field .hint{font-weight:400;color:var(--soft);font-size:13px;margin-left:6px}
.input,select.input,textarea.input{width:100%;border:1px solid var(--line);background:#fff;border-radius:var(--r);padding:12px 14px;font-size:17px}
textarea.input{min-height:90px;resize:vertical}
.qty{display:flex;align-items:stretch;gap:8px}
.qty input{text-align:center;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:26px;max-width:140px}
.qty button{width:54px;border:1px solid var(--line);background:var(--tag);border-radius:var(--r);font-size:24px;font-weight:600}
.onhand-note{font-size:14px;color:var(--soft);margin-top:6px}
.onhand-note.warn{color:var(--warn)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:var(--r);padding:14px 22px;font-weight:600;font-size:17px;background:var(--copper);color:#fff}
.btn:disabled{opacity:.55}
.btn.full{width:100%}
.btn.ghost{background:none;border:1px solid var(--line);color:var(--ink)}
.btn.patina{background:var(--patina)}
.btn.small{padding:8px 14px;font-size:15px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:640px){.grid2{grid-template-columns:1fr}}

/* Combobox */
.combo-list{position:absolute;left:0;right:0;top:100%;margin-top:4px;background:#fff;border:1px solid var(--line);border-radius:var(--r);
  max-height:300px;overflow-y:auto;z-index:20;box-shadow:0 10px 24px rgba(43,33,27,.14)}
.combo-list button{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid #F1E9DC;background:none;padding:11px 14px;font-size:16px}
.combo-list button:last-child{border-bottom:0}
.combo-list button.add{color:var(--copper-deep);font-weight:600}
.combo-list button small{color:var(--soft);margin-left:6px}
.newitem{background:var(--tag);border-radius:var(--r);padding:12px;margin-top:8px}

/* Toast, sheet */
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:40;
  background:var(--ink);color:var(--paper);padding:12px 18px;border-radius:12px;max-width:calc(100% - 32px);font-weight:500;display:none}
.toast.show{display:block;animation:pop .18s ease-out}
.toast.err{background:var(--warn)}
@keyframes pop{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
@media (prefers-reduced-motion:reduce){.toast.show{animation:none}}
.sheet-bg{position:fixed;inset:0;background:rgba(43,33,27,.4);z-index:30;display:none;align-items:flex-end;justify-content:center}
.sheet-bg.show{display:flex}
.sheet{background:var(--paper);width:100%;max-width:820px;max-height:88vh;overflow-y:auto;border-radius:18px 18px 0 0;
  padding:18px 20px calc(20px + env(safe-area-inset-bottom,0px))}
.sheet-head{display:flex;align-items:flex-start;gap:12px;margin-bottom:10px}
.sheet-head h2{margin:0;flex:1}

/* Tables */
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:600;color:var(--soft);font-size:13px;white-space:nowrap}
td.n,th.n{text-align:right;white-space:nowrap}
.ok{color:var(--patina);font-weight:600}
.bad{color:var(--warn);font-weight:600}
.pill{display:inline-block;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:600}
.pill.in{background:var(--patina-soft);color:var(--patina)}
.pill.out{background:var(--tag);color:var(--copper-deep)}
.pill.adj{background:#ECE8F3;color:#5A4A7A}
.pill.new{background:var(--warn-soft);color:var(--warn)}
.seg{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.seg button{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:8px 16px;font-weight:600}
.seg button.on{background:var(--copper);border-color:var(--copper);color:#fff}
.empty{padding:30px 10px;text-align:center;color:var(--soft)}
.pin{max-width:360px;margin:30px auto;text-align:center}
.pin input{text-align:center;letter-spacing:10px;font-size:30px;font-family:"Barlow Condensed",sans-serif}
.stat{display:flex;gap:18px;flex-wrap:wrap;margin:8px 0 14px}
.stat div{font-size:14px;color:var(--soft)}
.stat b{display:block;font-family:"Barlow Condensed",sans-serif;font-size:26px;color:var(--ink)}
.count-input{width:96px;text-align:right;border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:17px;background:#fff}
.count-input.changed{border-color:var(--copper);background:#FFF6EC}
.setup{max-width:560px;margin:40px auto}
.setup code{background:var(--tag);padding:2px 6px;border-radius:4px}
[hidden]{display:none!important}
</style>
</head>
<body>
<header class="top">
  <div class="brand">Warehouse<small>Crown Elite Plumbing</small></div>
  <div class="who">
    <button class="chip" id="whoBtn" type="button">Using: <span id="whoName">tap to set</span></button>
    <button class="chip" id="lockBtn" type="button" hidden>Lock owner</button>
  </div>
</header>

<main id="app"><div class="empty">Loading inventory…</div></main>

<nav class="tabs" aria-label="Sections">
  <button type="button" data-tab="stock" aria-current="page">Stock</button>
  <button type="button" data-tab="out">Take out</button>
  <button type="button" data-tab="in">Bring in</button>
  <button type="button" data-tab="owner">Owner</button>
</nav>

<div class="sheet-bg" id="sheetBg"><div class="sheet" id="sheet" role="dialog" aria-modal="true"></div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
/* ===== 1. PASTE YOUR APPS SCRIPT WEB APP URL HERE ===== */
const API = 'PASTE_YOUR_WEB_APP_URL_HERE';

const UOMS = ['EA','FT','RLL','BOX','BAG','CASE','GAL','LB','PR','SET'];
const CATS = ['PVC DWV','PEX (Uponor)','CPVC / PVC Pressure','Copper','Gas / Black Iron','Valves','Water Heaters & Parts','Fixtures & Trim','Tools & Shop Supplies','General Supplies'];

const S = {
  tab:'stock', data:{items:[],people:[],projects:[],moves:[]},
  pin:'', owner:null, ownerTab:'tickets', cat:'All', q:'',
  who: safeGet('whoName') || '', report:{type:'OUT',from:'',to:'',item:'',project:'',person:''}
};

function safeGet(k){ try{return localStorage.getItem(k)}catch(e){return null} }
function safeSet(k,v){ try{localStorage.setItem(k,v)}catch(e){} }
const $ = (s,el=document)=>el.querySelector(s);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm = s => String(s||'').trim().replace(/\s+/g,' ').toUpperCase();
const fmtQty = n => { n=Number(n)||0; return Number.isInteger(n)? n.toLocaleString() : n.toLocaleString(undefined,{maximumFractionDigits:3}); };
const money = n => '$'+(Number(n)||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
const today = () => { const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); };
const niceDate = s => { if(!s) return ''; const [y,m,d]=String(s).split('-'); return m&&d? `${m}/${d}/${y.slice(2)}` : s; };

/* ---------- API ---------- */
async function api(action, body){
  if(!API || API.startsWith('PASTE_')) throw new Error('The app is not connected yet');
  let res;
  if(!body){ res = await fetch(API+'?action='+encodeURIComponent(action)); }
  else { res = await fetch(API,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(Object.assign({action,by:S.who},body))}); }
  const j = await res.json();
  if(!j.ok) throw new Error(j.error||'Something went wrong');
  return j.data;
}
async function load(){ S.data = await api('bootstrap'); }
async function loadOwner(){ S.owner = await api('ownerData',{pin:S.pin}); }

function toast(msg, err){
  const t=$('#toast'); t.textContent=msg; t.className='toast show'+(err?' err':'');
  clearTimeout(t._t); t._t=setTimeout(()=>t.className='toast',err?4200:2600);
}

/* ---------- Combobox ---------- */
function combo(host, opts){
  // opts: {id, placeholder, value, options:()=>[{value,label,sub}], allowAdd, addLabel, onPick(value,isNew)}
  host.innerHTML = `<input class="input" id="${opts.id}" autocomplete="off" autocapitalize="characters" placeholder="${esc(opts.placeholder||'')}" value="${esc(opts.value||'')}"><div class="combo-list" hidden></div>`;
  const input=host.querySelector('input'), list=host.querySelector('.combo-list');
  const state={value:opts.value||'', isNew:false};
  function render(){
    const q=norm(input.value), words=q.split(' ').filter(Boolean);
    const all=opts.options();
    const hits=all.filter(o=>words.every(w=>norm(o.value).includes(w))).slice(0,60);
    const exact=all.some(o=>norm(o.value)===q);
    let h=hits.map(o=>`<button type="button" data-v="${esc(o.value)}">${esc(o.label||o.value)}${o.sub?`<small>${esc(o.sub)}</small>`:''}</button>`).join('');
    if(opts.allowAdd && q && !exact) h+=`<button type="button" class="add" data-add="1">${esc(opts.addLabel||'Add')} “${esc(input.value.trim())}”</button>`;
    if(!h) h=`<div class="empty" style="padding:12px">No match</div>`;
    list.innerHTML=h; list.hidden=false;
  }
  input.addEventListener('focus',render);
  input.addEventListener('input',()=>{ state.value=''; state.isNew=false; opts.onPick&&opts.onPick('',false); render(); });
  list.addEventListener('mousedown',e=>e.preventDefault());
  list.addEventListener('click',e=>{
    const b=e.target.closest('button'); if(!b) return;
    if(b.dataset.add){ state.value=input.value.trim().replace(/\s+/g,' '); state.isNew=true; }
    else { state.value=b.dataset.v; state.isNew=false; input.value=b.dataset.v; }
    list.hidden=true; input.blur(); opts.onPick&&opts.onPick(state.value,state.isNew);
  });
  input.addEventListener('blur',()=>setTimeout(()=>{
    list.hidden=true;
    if(!state.value){ const m=opts.options().find(o=>norm(o.value)===norm(input.value)); if(m){state.value=m.value;input.value=m.value;opts.onPick&&opts.onPick(m.value,false);} }
  },120));
  return state;
}
const itemOpts = () => S.data.items.map(i=>({value:i.item,sub:`${fmtQty(i.onHand)} ${i.uom} on hand`}));
const listOpts = arr => () => arr.map(v=>({value:v}));
const itemByName = n => S.data.items.find(i=>norm(i.item)===norm(n));

function qtyField(id){
  return `<div class="qty"><button type="button" data-step="-1" aria-label="Less">−</button><input class="input" id="${id}" type="number" inputmode="decimal" min="0" step="any" value="1"><button type="button" data-step="1" aria-label="More">+</button></div>`;
}
function wireQty(root,id,onChange){
  const inp=$('#'+id,root);
  root.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>{ inp.value=Math.max(0,(Number(inp.value)||0)+Number(b.dataset.step)); onChange&&onChange(); }));
  inp.addEventListener('input',()=>onChange&&onChange());
  return inp;
}

/* ---------- Views ---------- */
function render(){
  document.querySelectorAll('nav.tabs button').forEach(b=>b.setAttribute('aria-current',b.dataset.tab===S.tab?'page':'false'));
  $('#whoName').textContent=S.who||'tap to set';
  $('#lockBtn').hidden=!S.pin;
  const app=$('#app');
  if(!API || API.startsWith('PASTE_')) return setupView(app);
  ({stock:stockView,out:outView,in:inView,owner:ownerView})[S.tab](app);
  window.scrollTo(0,0);
}

function setupView(app){
  app.innerHTML=`<div class="setup card"><h1>Almost ready</h1>
  <p>This app still needs its connection to your Google Sheet. Open <code>index.html</code>, find <code>PASTE_YOUR_WEB_APP_URL_HERE</code> near the top of the script, and paste the Web app URL from Apps Script there.</p></div>`;
}

function stockView(app){
  const cats=['All',...CATS.filter(c=>S.data.items.some(i=>i.category===c)),...[...new Set(S.data.items.map(i=>i.category))].filter(c=>!CATS.includes(c))];
  app.innerHTML=`<h1>Stock on hand</h1>
  <div class="tools"><input class="search" id="q" type="search" placeholder="Search items" value="${esc(S.q)}" autocapitalize="characters"></div>
  <div class="cats">${cats.map(c=>`<button type="button" class="${c===S.cat?'on':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join('')}</div>
  <p class="count-line" id="countLine"></p><div class="list" id="list"></div>`;
  const draw=()=>{
    const words=norm(S.q).split(' ').filter(Boolean);
    const rows=S.data.items.filter(i=>(S.cat==='All'||i.category===S.cat)&&words.every(w=>norm(i.item).includes(w)))
      .sort((a,b)=>a.item.localeCompare(b.item));
    $('#countLine').textContent=`${rows.length} item${rows.length===1?'':'s'}`;
    $('#list').innerHTML=rows.length?rows.map(i=>`<button type="button" class="row" data-item="${esc(i.item)}">
      <div><div class="name">${esc(i.item)}</div><div class="meta">${esc(i.category)}</div></div>
      <div class="tag ${i.onHand<0?'neg':i.onHand===0?'zero':''}"><b>${fmtQty(i.onHand)}</b><span>${esc(i.uom)}</span></div></button>`).join('')
      :`<div class="empty">No items match. Add new material from Bring in.</div>`;
  };
  draw();
  $('#q').addEventListener('input',e=>{S.q=e.target.value;draw();});
  app.querySelectorAll('[data-cat]').forEach(b=>b.addEventListener('click',()=>{S.cat=b.dataset.cat;stockView(app);}));
  $('#list').addEventListener('click',e=>{const r=e.target.closest('[data-item]'); if(r) itemSheet(r.dataset.item);});
}

function itemSheet(name){
  const it=itemByName(name); if(!it) return;
  const moves=S.data.moves.filter(m=>m.item===it.item).slice().reverse().slice(0,40);
  let cost='';
  if(S.owner){
    const ls=S.owner.lines.filter(l=>l.Item===it.item);
    const q=ls.reduce((a,l)=>a+Number(l.Qty),0), x=ls.reduce((a,l)=>a+Number(l.Extension),0);
    const last=ls.slice().sort((a,b)=>String(b.Date).localeCompare(a.Date))[0];
    cost=`<div class="stat"><div><b>${q?money(x/q):'none'}</b>Avg cost / ${esc(it.uom)}</div><div><b>${last?money(last.UnitPrice):'none'}</b>Last price paid</div><div><b>${money(x)}</b>Bought on tickets</div></div>`;
  }
  openSheet(`<div class="sheet-head"><h2>${esc(it.item)}</h2><button class="btn ghost small" data-close>Close</button></div>
  <div class="stat"><div><b>${fmtQty(it.onHand)} ${esc(it.uom)}</b>On hand</div><div><b>${esc(it.category)}</b>Category</div></div>${cost}
  <div style="display:flex;gap:10px;margin:6px 0 16px"><button class="btn" data-go="out">Take out</button><button class="btn patina" data-go="in">Bring in</button></div>
  <h2>History</h2>${movesTable(moves)}`);
  $('#sheet').querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>{closeSheet();S.prefill=it.item;S.tab=b.dataset.go;render();}));
}

function movesTable(moves){
  if(!moves.length) return `<div class="empty">Nothing logged yet.</div>`;
  return `<div class="scroll"><table><tr><th>Date</th><th>Type</th><th class="n">Qty</th><th>Who</th><th>Project / ticket</th><th>Note</th></tr>
  ${moves.map(m=>`<tr><td>${niceDate(m.date)}</td><td>${pill(m.type)}</td><td class="n">${signed(m)}</td>
  <td>${esc(m.person)}</td><td>${esc(m.project||(m.ticket?'Ticket '+m.ticket:''))}</td><td>${esc(m.note)}</td></tr>`).join('')}</table></div>`;
}
const signed = m => { const v=m.type==='OUT'?-m.qty:m.qty; return (v>0?'+':v<0?'−':'')+fmtQty(Math.abs(v)); };
const pill = t => t==='OUT'?'<span class="pill out">Out</span>':t==='IN'?'<span class="pill in">In</span>':'<span class="pill adj">Count</span>';

function outView(app){
  app.innerHTML=`<h1>Take out material</h1><p class="lead">Log what leaves the warehouse, who took it, and which job it's for.</p>
  <form class="card" id="f" novalidate>
    <div class="field"><label for="oItem">Item</label><div id="cItem"></div><div class="onhand-note" id="oNote"></div></div>
    <div class="field"><label for="oQty">Quantity</label>${qtyField('oQty')}</div>
    <div class="grid2">
      <div class="field"><label for="oPerson">Given to</label><div id="cPerson"></div></div>
      <div class="field"><label for="oProject">Project <span class="hint">leave blank for tools given to a person</span></label><div id="cProject"></div></div>
    </div>
    <div class="field"><label for="oNoteIn">Note <span class="hint">optional</span></label><input class="input" id="oNoteIn"></div>
    <button class="btn full" id="go">Take out</button>
  </form>`;
  const note=$('#oNote');
  const refresh=()=>{ const it=itemByName(item.value); const q=Number($('#oQty').value)||0;
    if(!it){note.textContent='';return;}
    note.className='onhand-note'+(q>it.onHand?' warn':'');
    note.textContent=q>it.onHand?`Only ${fmtQty(it.onHand)} ${it.uom} on hand. You can still log it, and the count will go negative until it's fixed.`:`${fmtQty(it.onHand)} ${it.uom} on hand`; };
  const item=combo($('#cItem'),{id:'oItem',placeholder:'Search items',value:S.prefill||'',options:itemOpts,onPick:refresh});
  S.prefill='';
  const person=combo($('#cPerson'),{id:'oPerson',placeholder:'Who is taking it',options:listOpts(S.data.people),allowAdd:true,addLabel:'Add person'});
  const project=combo($('#cProject'),{id:'oProject',placeholder:'Pick or add a project',options:listOpts(S.data.projects),allowAdd:true,addLabel:'Add project'});
  wireQty(app,'oQty',refresh); refresh();
  $('#f').addEventListener('submit',async e=>{
    e.preventDefault();
    const it=itemByName(item.value);
    if(!it) return toast('Pick an item from the list',1);
    if(!(Number($('#oQty').value)>0)) return toast('Quantity has to be more than 0',1);
    const pv=person.value||$('#oPerson').value.trim(); if(!pv) return toast('Pick who is taking it',1);
    const prv=project.value||$('#oProject').value.trim();
    const btn=$('#go'); btn.disabled=true; btn.textContent='Saving…';
    try{
      const r=await api('stockOut',{item:it.item,qty:$('#oQty').value,person:pv,project:prv,note:$('#oNoteIn').value});
      await load(); toast(`Taken out: ${fmtQty($('#oQty').value)} ${it.uom}. ${fmtQty(r.onHand)} left.`); outView(app);
    }catch(err){ toast(err.message,1); btn.disabled=false; btn.textContent='Take out'; }
  });
}

function inView(app){
  app.innerHTML=`<h1>Bring in material</h1><p class="lead">Log material coming into the warehouse. Northside tickets are added from the Owner tab.</p>
  <form class="card" id="f" novalidate>
    <div class="field"><label for="iItem">Item</label><div id="cItem"></div><div class="onhand-note" id="iNote"></div>
      <div class="newitem" id="newBox" hidden><strong>New item.</strong> Use Northside's exact name so reports match their tickets.
        <div class="grid2" style="margin-top:10px"><div><label for="nUom">Unit</label><select class="input" id="nUom">${UOMS.map(u=>`<option>${u}</option>`).join('')}</select></div>
        <div><label for="nCat">Category</label><select class="input" id="nCat">${CATS.map(c=>`<option ${c==='General Supplies'?'selected':''}>${esc(c)}</option>`).join('')}</select></div></div></div></div>
    <div class="field"><label for="iQty">Quantity</label>${qtyField('iQty')}</div>
    <div class="field"><label for="iPerson">Brought in by <span class="hint">optional</span></label><div id="cPerson"></div></div>
    <div class="field"><label for="iNoteIn">Note <span class="hint">optional</span></label><input class="input" id="iNoteIn" placeholder="Where it came from"></div>
    <button class="btn patina full" id="go">Bring in</button>
  </form>`;
  const item=combo($('#cItem'),{id:'iItem',placeholder:'Search or add an item',value:S.prefill||'',options:itemOpts,allowAdd:true,addLabel:'Add new item',
    onPick:(v,isNew)=>{ $('#newBox').hidden=!isNew; const it=itemByName(v); $('#iNote').textContent=it?`${fmtQty(it.onHand)} ${it.uom} on hand`:''; }});
  S.prefill='';
  const person=combo($('#cPerson'),{id:'iPerson',placeholder:'Who brought it in',options:listOpts(S.data.people),allowAdd:true,addLabel:'Add person'});
  wireQty(app,'iQty');
  $('#f').addEventListener('submit',async e=>{
    e.preventDefault();
    const name=item.value||$('#iItem').value.trim();
    if(!name) return toast('Pick or add an item',1);
    if(!(Number($('#iQty').value)>0)) return toast('Quantity has to be more than 0',1);
    const btn=$('#go'); btn.disabled=true; btn.textContent='Saving…';
    try{
      let nm=name;
      if(!itemByName(name)){ const a=await api('addItem',{item:name,uom:$('#nUom').value,category:$('#nCat').value}); nm=a.item; }
      const r=await api('stockIn',{item:nm,qty:$('#iQty').value,person:person.value||$('#iPerson').value.trim(),note:$('#iNoteIn').value});
      await load(); toast(`Brought in. ${fmtQty(r.onHand)} on hand now.`); inView(app);
    }catch(err){ toast(err.message,1); btn.disabled=false; btn.textContent='Bring in'; }
  });
}

/* ---------- Owner ---------- */
function ownerView(app){
  if(!S.pin){
    app.innerHTML=`<div class="pin card"><h1>Owner</h1><p>Prices, tickets, counts and reports.</p>
    <input class="input" id="pin" type="password" inputmode="numeric" autocomplete="off" placeholder="PIN">
    <button class="btn full" id="unlock" style="margin-top:12px">Unlock</button></div>`;
    const go=async()=>{ const pin=$('#pin').value.trim(); if(!pin) return;
      try{ await api('ownerCheck',{pin}); S.pin=pin; await loadOwner(); render(); }catch(err){ toast(err.message,1); $('#pin').value=''; } };
    $('#unlock').addEventListener('click',go);
    $('#pin').addEventListener('keydown',e=>{if(e.key==='Enter')go();});
    $('#pin').focus(); return;
  }
  const tabs={tickets:'Tickets',add:'Add ticket',count:'Count',reports:'Reports'};
  app.innerHTML=`<h1>Owner</h1><div class="seg">${Object.entries(tabs).map(([k,v])=>`<button type="button" class="${S.ownerTab===k?'on':''}" data-o="${k}">${v}</button>`).join('')}</div><div id="ob"></div>`;
  app.querySelectorAll('[data-o]').forEach(b=>b.addEventListener('click',()=>{S.ownerTab=b.dataset.o;ownerView(app);}));
  ({tickets:ticketsView,add:addTicketView,count:countView,reports:reportsView})[S.ownerTab]($('#ob'));
}

function ticketCheck(t){
  const ls=S.owner.lines.filter(l=>l.Ticket===t.Ticket);
  const sum=ls.reduce((a,l)=>a+Number(l.Extension),0);
  const ok=Math.abs(sum-Number(t.Subtotal))<0.02 && Math.abs(Number(t.Subtotal)+Number(t.Tax)-Number(t.Total))<0.02;
  return {ls,sum,ok};
}
function ticketsView(el){
  const ts=S.owner.tickets.slice().sort((a,b)=>String(b.Date).localeCompare(a.Date)||String(b.Ticket).localeCompare(a.Ticket));
  const total=ts.reduce((a,t)=>a+Number(t.Total),0);
  el.innerHTML=`<div class="stat"><div><b>${ts.length}</b>Tickets</div><div><b>${money(total)}</b>Total billed</div></div>
  <div class="scroll"><table><tr><th>Ticket</th><th>Date</th><th>P.O.</th><th class="n">Lines</th><th class="n">Total</th><th>Check</th></tr>
  ${ts.map(t=>{const c=ticketCheck(t);return `<tr data-t="${esc(t.Ticket)}" style="cursor:pointer"><td><b>${esc(t.Ticket)}</b></td><td>${niceDate(t.Date)}</td><td>${esc(t.PO)}</td>
  <td class="n">${c.ls.length}</td><td class="n">${money(t.Total)}</td><td class="${c.ok?'ok':'bad'}">${c.ok?'OK':'Check'}</td></tr>`}).join('')}</table></div>`;
  el.querySelectorAll('[data-t]').forEach(r=>r.addEventListener('click',()=>ticketSheet(r.dataset.t)));
}
function ticketSheet(no){
  const t=S.owner.tickets.find(x=>x.Ticket===no); const c=ticketCheck(t);
  openSheet(`<div class="sheet-head"><h2>Ticket ${esc(t.Ticket)}</h2><button class="btn ghost small" data-close>Close</button></div>
  <div class="stat"><div><b>${niceDate(t.Date)}</b>Date</div><div><b>${esc(t.PO)||'none'}</b>P.O.</div><div><b>${money(t.Total)}</b>Total</div><div><b class="${c.ok?'ok':'bad'}">${c.ok?'OK':'Check'}</b>Totals check</div></div>
  <p style="color:var(--soft);margin-top:-4px">${esc(t.ShipVia)}${t.PickTicket?', pick ticket '+esc(t.PickTicket):''}</p>
  ${t.PdfLink?`<p><a class="btn ghost small" href="${esc(t.PdfLink)}" target="_blank" rel="noopener">Open the PDF</a></p>`:''}
  <div class="scroll"><table><tr><th class="n">Qty</th><th>Northside description</th><th>UOM</th><th class="n">Price</th><th class="n">Ext.</th></tr>
  ${c.ls.map(l=>`<tr><td class="n">${fmtQty(l.Qty)}</td><td>${esc(l.NorthsideDescription)}${l.Item!==l.NorthsideDescription?`<div style="color:var(--soft);font-size:12px">Stocked as ${esc(l.Item)}</div>`:''}</td><td>${esc(l.UOM)}</td>
  <td class="n">${money(l.UnitPrice)}</td><td class="n">${money(l.Extension)}</td></tr>`).join('')}
  <tr><td></td><td class="n" colspan="3">Lines total</td><td class="n"><b>${money(c.sum)}</b></td></tr>
  <tr><td></td><td class="n" colspan="3">Subtotal on ticket</td><td class="n">${money(t.Subtotal)}</td></tr>
  <tr><td></td><td class="n" colspan="3">Sales tax</td><td class="n">${money(t.Tax)}</td></tr>
  <tr><td></td><td class="n" colspan="3">Invoice total</td><td class="n"><b>${money(t.Total)}</b></td></tr></table></div>`);
}

function addTicketView(el){
  el.innerHTML=`<p class="lead">Paste the ticket block Claude gives you. You'll review every line before anything is added.</p>
  <div class="field"><textarea class="input" id="paste" style="min-height:160px;font-size:14px" placeholder='{"ticket":{...},"lines":[...]}'></textarea></div>
  <button class="btn" id="read">Review ticket</button><div id="review"></div>`;
  $('#read').addEventListener('click',()=>{
    let d; try{ d=JSON.parse($('#paste').value.trim()); }catch(e){ return toast('That block could not be read. Copy the whole block from Claude and try again.',1); }
    const tickets=Array.isArray(d)?d:[d]; reviewTickets(tickets,$('#review'));
  });
}
function reviewTickets(tickets,box){
  const nameMap={}; S.owner.names.forEach(n=>nameMap[norm(n.NorthsideDescription)]=n.Item);
  const exists=new Set(S.owner.tickets.map(t=>norm(t.Ticket)));
  box.innerHTML=tickets.map((d,ti)=>{
    const t=d.ticket||{}; const ls=d.lines||[];
    const sum=ls.reduce((a,l)=>a+Number(l.ext||0),0);
    const ok=Math.abs(sum-Number(t.subtotal))<0.02 && Math.abs(Number(t.subtotal)+Number(t.tax)-Number(t.total))<0.02;
    const dup=exists.has(norm(t.no));
    return `<div class="card" style="margin-top:16px" data-ti="${ti}">
      <h2 style="margin-top:0">Ticket ${esc(t.no)} <span style="font-weight:500;color:var(--soft);font-size:17px">${niceDate(t.date)}, P.O. ${esc(t.po||'none')}</span></h2>
      ${dup?`<p class="bad">This ticket is already in the app, so it will be skipped.</p>`:''}
      <p class="${ok?'ok':'bad'}">${ok?`Totals check OK: lines add up to ${money(sum)}, total ${money(t.total)}`:`Totals don't match: lines add up to ${money(sum)} but the ticket subtotal is ${money(t.subtotal)}. Check the PDF before saving.`}</p>
      <div class="scroll"><table><tr><th class="n">Qty</th><th>Northside description</th><th>Goes into inventory as</th><th class="n">Ext.</th></tr>
      ${ls.map((l,li)=>{const m=itemByName(l.desc)?l.desc:(nameMap[norm(l.desc)]||'');
        return `<tr><td class="n">${fmtQty(l.qty)} ${esc(l.uom)}</td><td>${esc(l.desc)}</td>
        <td style="min-width:240px"><div class="field" style="margin:0" id="m_${ti}_${li}"></div>${m?'':'<span class="pill new">New item</span>'}</td><td class="n">${money(l.ext)}</td></tr>`}).join('')}</table></div>
      ${dup?'':`<button class="btn" style="margin-top:12px" data-save="${ti}">Add ticket ${esc(t.no)} to inventory</button>`}</div>`;
  }).join('');
  const picks={};
  tickets.forEach((d,ti)=>(d.lines||[]).forEach((l,li)=>{
    const m=itemByName(l.desc)?itemByName(l.desc).item:(nameMap[norm(l.desc)]||'');
    picks[ti+'_'+li]=combo($('#m_'+ti+'_'+li),{id:'mi_'+ti+'_'+li,placeholder:'Pick existing or keep new',value:m||l.desc,options:itemOpts,allowAdd:true,addLabel:'Keep as new item'});
    if(!picks[ti+'_'+li].value) picks[ti+'_'+li].value=m||l.desc;
  }));
  box.querySelectorAll('[data-save]').forEach(b=>b.addEventListener('click',async()=>{
    const ti=Number(b.dataset.save), d=tickets[ti];
    const lines=(d.lines||[]).map((l,li)=>{ const v=picks[ti+'_'+li].value||$('#mi_'+ti+'_'+li).value.trim()||l.desc;
      return {desc:l.desc,qty:l.qty,uom:l.uom,price:l.price,ext:l.ext,item:v,category:l.category||'General Supplies'}; });
    b.disabled=true; b.textContent='Adding…';
    try{ const r=await api('importTicket',{pin:S.pin,ticket:d.ticket,lines}); await load(); await loadOwner();
      toast(`Ticket ${r.ticket} added: ${r.lines} lines`); b.textContent='Added'; exists.add(norm(d.ticket.no)); }
    catch(err){ toast(err.message,1); b.disabled=false; b.textContent=`Add ticket ${d.ticket.no} to inventory`; }
  }));
}

function countView(el){
  el.innerHTML=`<p class="lead">Type what's actually on the shelf. Only changed items are saved, and each one is logged as a count adjustment.</p>
  <div class="tools"><input class="search" id="cq" type="search" placeholder="Search items" autocapitalize="characters"></div>
  <div class="list" id="cl"></div>
  <div class="field" style="margin-top:14px"><label for="cNote">Note <span class="hint">optional</span></label><input class="input" id="cNote" placeholder="Monthly count"></div>
  <button class="btn full" id="csave" disabled>Save counts</button>`;
  const counts={};
  const draw=()=>{ const w=norm($('#cq').value).split(' ').filter(Boolean);
    $('#cl').innerHTML=S.data.items.filter(i=>w.every(x=>norm(i.item).includes(x))).sort((a,b)=>a.item.localeCompare(b.item)).map(i=>`
    <div class="row"><div><div class="name">${esc(i.item)}</div><div class="meta">App says ${fmtQty(i.onHand)} ${esc(i.uom)}</div></div>
    <input class="count-input ${counts[i.item]!=null?'changed':''}" type="number" inputmode="decimal" min="0" step="any" data-c="${esc(i.item)}" placeholder="${fmtQty(i.onHand)}" value="${counts[i.item]??''}"></div>`).join(''); };
  draw();
  $('#cq').addEventListener('input',draw);
  $('#cl').addEventListener('input',e=>{ const inp=e.target.closest('[data-c]'); if(!inp) return;
    if(inp.value==='') delete counts[inp.dataset.c]; else counts[inp.dataset.c]=inp.value;
    inp.classList.toggle('changed',inp.value!==''); const n=Object.keys(counts).length;
    $('#csave').disabled=!n; $('#csave').textContent=n?`Save counts (${n})`:'Save counts'; });
  $('#csave').addEventListener('click',async()=>{
    const b=$('#csave'); b.disabled=true; b.textContent='Saving…';
    try{ const r=await api('count',{pin:S.pin,note:$('#cNote').value,counts:Object.entries(counts).map(([item,counted])=>({item,counted}))});
      await load(); toast(`Counts saved. ${r.adjusted} item${r.adjusted===1?'':'s'} adjusted.`); countView(el); }
    catch(err){ toast(err.message,1); b.disabled=false; b.textContent='Save counts'; }
  });
}

function reportsView(el){
  const R=S.report;
  el.innerHTML=`<div class="card"><div class="grid2">
    <div class="field"><label for="rType">Show</label><select class="input" id="rType">
      <option value="OUT">Taken out</option><option value="IN">Brought in</option><option value="ADJUST">Count adjustments</option><option value="ALL">Everything</option></select></div>
    <div class="grid2"><div class="field"><label for="rFrom">From</label><input class="input" type="date" id="rFrom" value="${R.from}"></div>
      <div class="field"><label for="rTo">To</label><input class="input" type="date" id="rTo" value="${R.to}"></div></div>
    <div class="field"><label for="rItem">Item</label><div id="cItem"></div></div>
    <div class="field"><label for="rProj">Project</label><div id="cProj"></div></div>
    <div class="field"><label for="rPer">Person</label><div id="cPer"></div></div>
    <div class="field" style="display:flex;align-items:flex-end;gap:8px"><button class="btn" id="run">Show report</button><button class="btn ghost" id="clr">Clear</button></div>
  </div></div><div id="rOut"></div>`;
  $('#rType').value=R.type;
  const ci=combo($('#cItem'),{id:'rItem',placeholder:'All items',value:R.item,options:itemOpts});
  const cp=combo($('#cProj'),{id:'rProj',placeholder:'All projects',value:R.project,options:listOpts(S.data.projects)});
  const cq=combo($('#cPer'),{id:'rPer',placeholder:'Everyone',value:R.person,options:listOpts(S.data.people)});
  const run=()=>{
    Object.assign(R,{type:$('#rType').value,from:$('#rFrom').value,to:$('#rTo').value,item:$('#rItem').value.trim()?ci.value||$('#rItem').value.trim():'',
      project:$('#rProj').value.trim()?cp.value||$('#rProj').value.trim():'',person:$('#rPer').value.trim()?cq.value||$('#rPer').value.trim():''});
    const rows=S.data.moves.filter(m=>(R.type==='ALL'||m.type===R.type)&&(!R.from||m.date>=R.from)&&(!R.to||m.date<=R.to)
      &&(!R.item||norm(m.item)===norm(R.item))&&(!R.project||norm(m.project)===norm(R.project))&&(!R.person||norm(m.person)===norm(R.person)));
    const by={}; rows.forEach(m=>{ const k=m.item; by[k]=by[k]||{qty:0,n:0,uom:(itemByName(k)||{}).uom||''};
      by[k].qty+=m.type==='OUT'?-m.qty:m.qty; by[k].n++; });
    const sumRows=Object.entries(by).sort((a,b)=>a[0].localeCompare(b[0]));
    S.lastReport=rows;
    $('#rOut').innerHTML=rows.length?`<div class="stat"><div><b>${rows.length}</b>Entries</div><div><b>${sumRows.length}</b>Items</div>
      <div style="margin-left:auto;align-self:center"><button class="btn ghost small" id="csv">Export to Excel (CSV)</button></div></div>
      <h2>Totals by item</h2><div class="scroll"><table><tr><th>Item</th><th class="n">Qty</th><th>UOM</th><th class="n">Entries</th></tr>
      ${sumRows.map(([k,v])=>`<tr><td>${esc(k)}</td><td class="n"><b>${fmtQty(R.type==='OUT'?Math.abs(v.qty):v.qty)}</b></td><td>${esc(v.uom)}</td><td class="n">${v.n}</td></tr>`).join('')}</table></div>
      <h2>Every entry</h2>${movesTableWithItem(rows.slice().reverse())}`
      :`<div class="empty">Nothing matches these filters. Try a wider date range.</div>`;
    const c=$('#csv'); if(c) c.addEventListener('click',exportCsv);
  };
  $('#run').addEventListener('click',run);
  $('#clr').addEventListener('click',()=>{S.report={type:'OUT',from:'',to:'',item:'',project:'',person:''};reportsView(el);});
}
function movesTableWithItem(moves){
  return `<div class="scroll"><table><tr><th>Date</th><th>Type</th><th>Item</th><th class="n">Qty</th><th>Who</th><th>Project / ticket</th><th>Note</th></tr>
  ${moves.map(m=>`<tr><td>${niceDate(m.date)}</td><td>${pill(m.type)}</td><td>${esc(m.item)}</td><td class="n">${signed(m)}</td>
  <td>${esc(m.person)}</td><td>${esc(m.project||(m.ticket?'Ticket '+m.ticket:''))}</td><td>${esc(m.note)}</td></tr>`).join('')}</table></div>`;
}
function exportCsv(){
  const head=['Date','Type','Item','UOM','Qty','Person','Project','Ticket','Note','Logged by'];
  const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const lines=[head.map(q).join(',')].concat(S.lastReport.map(m=>[m.date,m.type,m.item,(itemByName(m.item)||{}).uom||'',m.qty,m.person,m.project,m.ticket,m.note,m.by].map(q).join(',')));
  const blob=new Blob(['\ufeff'+lines.join('\r\n')],{type:'text/csv'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`warehouse-report-${today()}.csv`;
  document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);
}

