/**
 * Crown Elite Plumbing Warehouse Inventory backend
 * 1. Open a blank Google Sheet, then Extensions > Apps Script.
 * 2. Replace everything in Code.gs with this file and save.
 * 3. Pick "setup" in the function menu and click Run (approve access once).
 * 4. Deploy > New deployment > Web app. Execute as: Me. Who has access: Anyone.
 * 5. Copy the Web app URL into index.html where it says PASTE_YOUR_WEB_APP_URL_HERE.
 * Change the owner PIN on the Settings tab (default 1234).
 */

const HEAD = {
  Items: ['Item', 'UOM', 'Category', 'Added', 'AddedBy'],
  Movements: ['ID', 'Date', 'Type', 'Item', 'Qty', 'Ticket', 'Person', 'Project', 'Note', 'LoggedBy', 'Timestamp'],
  Tickets: ['Ticket', 'Date', 'PO', 'ShipVia', 'PickTicket', 'Subtotal', 'Tax', 'Total', 'PdfLink', 'AddedBy', 'AddedAt'],
  TicketLines: ['Ticket', 'Date', 'NorthsideDescription', 'Item', 'Qty', 'UOM', 'UnitPrice', 'Extension'],
  People: ['Name'],
  Projects: ['Name', 'Active'],
  NameMap: ['NorthsideDescription', 'Item'],
  Settings: ['Key', 'Value']
};

function setup() {
  const ss = SpreadsheetApp.getActive();
  Object.keys(HEAD).forEach(function (name) {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (sh.getLastRow() === 0) {
      sh.getRange(1, 1, 1, HEAD[name].length).setValues([HEAD[name]]).setFontWeight('bold');
      sh.setFrozenRows(1);
    }
  });
  const blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0) ss.deleteSheet(blank);
  if (rows_('Items').length === 0) {
    ['Items', 'NameMap', 'Tickets', 'TicketLines', 'Movements'].forEach(function (n) {
      if (SEED[n].length) append_(n, SEED[n]);
    });
  }
  if (getSetting_('OwnerPIN') === '') append_('Settings', [['OwnerPIN', '1234']]);
}

function doGet(e) { return handle_((e && e.parameter) || {}); }
function doPost(e) {
  let p = {};
  try { p = JSON.parse(e.postData.contents); } catch (err) {}
  return handle_(p);
}

const WRITES = ['stockOut', 'stockIn', 'addItem', 'addPerson', 'addProject', 'importTicket', 'count'];

function handle_(p) {
  let lock = null;
  try {
    const fn = ACTIONS[p.action];
    if (!fn) throw new Error('Unknown action');
    if (WRITES.indexOf(p.action) >= 0) {
      lock = LockService.getScriptLock();
      lock.waitLock(20000);
    }
    return json_({ ok: true, data: fn(p) });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message ? err.message : err) });
  } finally {
    if (lock) lock.releaseLock();
  }
}

const ACTIONS = {
  bootstrap: function () {
    const on = onHand_();
    return {
      items: rows_('Items').map(function (r) {
        return { item: r.Item, uom: r.UOM, category: r.Category, onHand: round_(on[r.Item] || 0) };
      }),
      people: rows_('People').map(function (r) { return r.Name; }),
      projects: rows_('Projects').filter(function (r) { return String(r.Active).toUpperCase() !== 'NO'; })
        .map(function (r) { return r.Name; }),
      moves: rows_('Movements').map(function (r) {
        return { id: r.ID, date: r.Date, type: r.Type, item: r.Item, qty: Number(r.Qty) || 0,
          ticket: r.Ticket, person: r.Person, project: r.Project, note: r.Note, by: r.LoggedBy };
      })
    };
  },

  stockOut: function (p) {
    const item = mustItem_(p.item);
    const qty = mustQty_(p.qty);
    if (!clean_(p.person)) throw new Error('Pick who is taking it');
    const person = ensure_('People', p.person);
    const project = clean_(p.project) ? ensure_('Projects', p.project) : '';
    append_('Movements', [[id_(), today_(), 'OUT', item, qty, '', person, project, clean_(p.note), clean_(p.by), stamp_()]]);
    return { item: item, onHand: round_(onHand_()[item] || 0) };
  },

  stockIn: function (p) {
    const item = mustItem_(p.item);
    const qty = mustQty_(p.qty);
    const person = clean_(p.person) ? ensure_('People', p.person) : '';
    append_('Movements', [[id_(), today_(), 'IN', item, qty, '', person, '', clean_(p.note), clean_(p.by), stamp_()]]);
    return { item: item, onHand: round_(onHand_()[item] || 0) };
  },

  addItem: function (p) {
    const name = clean_(p.item);
    if (!name) throw new Error('Type the item name');
    const found = findItem_(name);
    if (found) return { item: found, existed: true };
    append_('Items', [[name, clean_(p.uom) || 'EA', clean_(p.category) || 'General Supplies', today_(), clean_(p.by)]]);
    return { item: name, existed: false };
  },

  addPerson: function (p) { return { name: ensure_('People', p.name) }; },
  addProject: function (p) { return { name: ensure_('Projects', p.name) }; },

  ownerCheck: function (p) { owner_(p); return true; },

  ownerData: function (p) {
    owner_(p);
    return { tickets: rows_('Tickets'), lines: rows_('TicketLines'), names: rows_('NameMap') };
  },

  importTicket: function (p) {
    owner_(p);
    const t = p.ticket || {};
    const no = clean_(t.no);
    if (!no) throw new Error('Ticket number is missing');
    if (rows_('Tickets').some(function (r) { return norm_(r.Ticket) === norm_(no); })) {
      throw new Error('Ticket ' + no + ' is already in the app');
    }
    const lines = p.lines || [];
    if (!lines.length) throw new Error('The ticket has no lines');
    const date = clean_(t.date) || today_();
    const mapped = {};
    rows_('NameMap').forEach(function (r) { mapped[norm_(r.NorthsideDescription)] = true; });
    const tl = [], mv = [];
    lines.forEach(function (l) {
      const desc = clean_(l.desc);
      let item = findItem_(l.item || desc);
      if (!item) {
        item = clean_(l.item) || desc;
        append_('Items', [[item, clean_(l.uom) || 'EA', clean_(l.category) || 'General Supplies', today_(), clean_(p.by)]]);
      }
      if (norm_(desc) !== norm_(item) && !mapped[norm_(desc)]) {
        append_('NameMap', [[desc, item]]);
        mapped[norm_(desc)] = true;
      }
      tl.push([no, date, desc, item, Number(l.qty), clean_(l.uom), Number(l.price), Number(l.ext)]);
      mv.push([id_(), date, 'IN', item, Number(l.qty), no, clean_(t.po), '', 'Northside ticket', clean_(p.by), stamp_()]);
    });
    append_('Tickets', [[no, date, clean_(t.po), clean_(t.shipVia), clean_(t.pick), t.subtotal, t.tax, t.total,
      clean_(t.pdf), clean_(p.by), stamp_()]]);
    append_('TicketLines', tl);
    append_('Movements', mv);
    return { ticket: no, lines: tl.length };
  },

  count: function (p) {
    owner_(p);
    const on = onHand_();
    const out = [];
    (p.counts || []).forEach(function (c) {
      const item = mustItem_(c.item);
      const counted = Number(c.counted);
      if (isNaN(counted) || counted < 0) throw new Error('Count for ' + item + ' is not a number');
      const diff = round_(counted - (on[item] || 0));
      if (diff !== 0) {
        out.push([id_(), today_(), 'ADJUST', item, diff, '', '', '',
          ('Physical count: ' + counted + ' on shelf. ' + clean_(p.note)).trim(), clean_(p.by), stamp_()]);
      }
    });
    if (out.length) append_('Movements', out);
    return { adjusted: out.length };
  }
};

/* helpers */
function json_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
function sheet_(name) {
  const sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error('Run setup first: missing tab ' + name);
  return sh;
}
function rows_(name) {
  const sh = sheet_(name);
  const last = sh.getLastRow();
  if (last < 2) return [];
  const head = HEAD[name];
  return sh.getRange(2, 1, last - 1, head.length).getValues().map(function (v) {
    const o = {};
    head.forEach(function (h, i) {
      o[h] = v[i] instanceof Date ? Utilities.formatDate(v[i], Session.getScriptTimeZone(), 'yyyy-MM-dd') : v[i];
    });
    return o;
  }).filter(function (o) { return String(o[head[0]]) !== ''; });
}
function append_(name, arr) {
  const sh = sheet_(name);
  const rng = sh.getRange(sh.getLastRow() + 1, 1, arr.length, arr[0].length);
  rng.setNumberFormat('@');
  rng.setValues(arr.map(function (a) { return a.map(function (v) { return v == null ? '' : String(v); }); }));
}
function clean_(s) { return String(s == null ? '' : s).trim().replace(/\s+/g, ' '); }
function norm_(s) { return clean_(s).toUpperCase(); }
function round_(n) { return Math.round(n * 1000) / 1000; }
function id_() { return Utilities.getUuid().slice(0, 8); }
function today_() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd'); }
function stamp_() { return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm'); }
function findItem_(name) {
  const n = norm_(name);
  if (!n) return '';
  const hit = rows_('Items').filter(function (r) { return norm_(r.Item) === n; })[0];
  if (hit) return hit.Item;
  const m = rows_('NameMap').filter(function (r) { return norm_(r.NorthsideDescription) === n; })[0];
  return m ? m.Item : '';
}
function mustItem_(name) {
  const item = findItem_(name);
  if (!item) throw new Error('"' + clean_(name) + '" is not in the item list yet');
  return item;
}
function mustQty_(q) {
  const n = Number(q);
  if (!(n > 0)) throw new Error('Quantity has to be more than 0');
  return n;
}
function ensure_(tab, name) {
  const v = clean_(name);
  if (!v) throw new Error('Name is empty');
  const hit = rows_(tab).filter(function (r) { return norm_(r.Name) === norm_(v); })[0];
  if (hit) return hit.Name;
  append_(tab, [tab === 'Projects' ? [v, 'YES'] : [v]]);
  return v;
}
function onHand_() {
  const m = {};
  rows_('Movements').forEach(function (r) {
    const q = Number(r.Qty) || 0;
    m[r.Item] = (m[r.Item] || 0) + (r.Type === 'OUT' ? -q : q);
  });
  return m;
}
function getSetting_(key) {
  const hit = rows_('Settings').filter(function (r) { return r.Key === key; })[0];
  return hit ? String(hit.Value).trim() : '';
}
function owner_(p) {
  const pin = getSetting_('OwnerPIN');
  if (!pin || String(p.pin || '').trim() !== pin) throw new Error('Wrong owner PIN');
}

